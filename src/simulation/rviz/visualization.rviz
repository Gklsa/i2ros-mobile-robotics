Panels:
  - Class: rviz_common/Displays
    Help Height: 79
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /RGB_Right2
        - /RGB_Left2
        - /Segmentation Camera1
        - /Depth Camera2
      Splitter Ratio: 0.5403376817703247
    Tree Height: 1055
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/ToolProperties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
      - /Vehicle TPS Back1
      - /Vehicle TPS Side1
      - /Vehicle Top1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
    SyncSource: RGB_Right
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
